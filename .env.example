# Plantilla de variables de entorno. Copia a `.env` y rellena.
#
#     cp .env.example .env
#
# `.env` está en .gitignore y NO debe versionarse nunca.

# --- Modelos ---------------------------------------------------------------

# Perfil activo de config/models.yaml:
#   dev  -> DeepSeek en la nube. Para desarrollar sin GPU.
#   prod -> Ollama local (qwen3.8 + gemma3:12b) en el PC con la RTX 5090.
INTELLIPRINT_PROFILE=dev

# Requerida con el perfil `dev`, y opcional con `prod` (escalamiento, § 6.2).
# Si falta, el escalamiento a DeepSeek se desactiva sin romper nada.
DEEPSEEK_API_KEY=

# Opcionales: si no se definen se usan los valores por defecto.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat        # o deepseek-reasoner

# --- Ollama (solo perfil prod) ---------------------------------------------

# OLLAMA_URL=http://ollama:11434
# OLLAMA_MAX_LOADED_MODELS=2

# --- Canal humano (Fase 5) -------------------------------------------------

# Nombre del sistema en el canal. Vive aquí y no repartido por los prompts.
AGENT_NAME=Crafty

# TELEGRAM_BOT_TOKEN=                # SECRETO: quien lo tenga controla el bot
# TELEGRAM_ALLOWED_USERS=            # OBLIGATORIA para arrancar el canal.
#                                    # Deuda ADR-012: durante el desarrollo el
#                                    # canal va abierto. La cierra F5.10.

# --- Límites ---------------------------------------------------------------

# MAX_CONCURRENT_PROJECTS=2
# MAX_PARALLEL_PARTS=4
